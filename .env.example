# ==============================================================================
# Decode Application Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual credentials.
# NEVER commit .env or secrets to version control.
# ==============================================================================

# Google Gemini API Key (obtain from https://aistudio.google.com/)
GEMINIAI_API_KEY=your_gemini_api_key_here

# Supabase Public API Configuration (obtain from Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here

# PostgreSQL Database Connections (obtain from Supabase Project Settings -> Database)
# Shared transaction-mode pooler (IPv4)
DATABASE_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct/session connection (IPv4)
DIRECT_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Google OAuth Credentials (for Supabase Google Auth Provider)
OAUTH_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
OAUTH_CLIENT_SECRET=your_google_oauth_client_secret

# Vercel / GitHub Actions Cron Secret (for securing /api/cron/keepalive)
# Generate a random 32+ character string (e.g., openssl rand -hex 32)
CRON_SECRET=your_secure_cron_secret_here
